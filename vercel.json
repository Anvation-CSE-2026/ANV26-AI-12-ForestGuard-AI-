{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/user",
      "destination": "/user.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
